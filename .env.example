# Public HTTPS origin for the Vercel deployment. Used for the GitHub OAuth callback.
OAUTH_BASE_URL=https://your-project.vercel.app

# Comma-separated exact hostnames allowed to use the CMS sign-in popup.
ALLOWED_DOMAINS=your-project.vercel.app

# OAuth App credentials. Keep the secret only in Vercel Environment Variables.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional canonical website URL used in the Sveltia CMS config.
SITE_URL=https://your-project.vercel.app
